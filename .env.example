# Variáveis do app. No Hangar, as do banco e do Redis vêm por referência:
#   DATABASE_URL=${{db.DATABASE_URL}}
#   REDIS_URL / CELERY_BROKER_URL apontando para o Redis do projeto
SECRET_KEY=troque-por-uma-chave-longa
DATABASE_URL=postgres://app:senha-local@db:5432/app
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
DJANGO_ALLOWED_HOSTS=*
DEBUG=0
